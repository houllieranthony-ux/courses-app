# Copy this file to .env and fill in the values from your Firebase project
# (Project settings > General > Your apps > SDK setup and configuration).
# These are public client identifiers, not secrets.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Project settings > Cloud Messaging > Web Push certificates > key pair
VITE_FIREBASE_VAPID_KEY=

# Any short string, same for both of you (defaults to "foyer" if left empty)
VITE_HOUSEHOLD_ID=foyer

# URL of the Cloudflare Worker deployed from worker/ (see worker/README.md).
# Leave empty to hide the "going shopping" / "checkout" notification buttons.
VITE_NOTIFY_WORKER_URL=
