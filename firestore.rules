rules_version = '2';

// Private app for two people: no public sign-up, only the 2 accounts you
// create by hand in the Firebase console can authenticate at all, so
// "signed in" is an acceptable access check for every household document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{householdId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
